<nav class="breadcrumbs" aria-label="Хлебные крошки"><a href="/">Каталог</a><span>/</span><span><%= @game.title %></span></nav>
<div class="page-stack">
  <div class="game-detail">
    <article>
      <div class="detail-cover">
        <img src="<%= @game.image_url %>" alt="Обложка <%= @game.title %>">
        <span class="rating-badge"><i class="fa-solid fa-star"></i><%= @game.average_rating %> / 10</span>
      </div>
      <p class="eyebrow"><%= @game.genres.map(&:name).join(' · ') %></p>
      <h1 class="detail-title"><%= @game.title %></h1>
      <div class="detail-meta">
        <div><span>Дата выхода</span><strong><%= @game.release_date&.strftime("%d.%m.%Y") || "—" %></strong></div>
        <div><span>Разработчик</span><strong><%= @game.developer || "—" %></strong></div>
        <div><span>Издатель</span><strong><%= @game.publisher || "—" %></strong></div>
        <div><span>Платформы</span><strong><%= @game.platforms || "PC" %></strong></div>
      </div>
      <p class="detail-description"><%= @game.description %></p>
      <% if @game.tags.any? %>
        <div class="tag-list"><% @game.tags.each do |tag| %><span class="tag">#<%= tag.name %></span><% end %></div>
      <% end %>
    </article>
    <%= render partial: "interactions/form", locals: { game: @game, interaction: @interaction } %>
  </div>

  <% if @similar_games.any? %>
    <section>
      <div class="section-heading"><div><h2>Похожие по настроению</h2><p>Общие жанры и теги с <%= @game.title %></p></div></div>
      <div class="game-grid">
        <% @similar_games.each do |similar| %>
          <article class="game-card">
            <a href="<%= game_path(similar) %>" class="game-cover"><img src="<%= similar.image_url %>" alt="Обложка <%= similar.title %>" loading="lazy"><span class="rating-badge"><i class="fa-solid fa-star"></i><%= similar.average_rating %></span></a>
            <div class="game-card-body">
              <a href="<%= game_path(similar) %>" class="game-title"><%= similar.title %></a>
              <div class="game-card-footer"><div class="genre-list"><% similar.genres.first(2).each do |genre| %><span class="genre"><%= genre.name %></span><% end %></div><span><%= similar.release_date&.year %></span></div>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
