<div class="page-stack">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Ваш следующий любимый мир</p>
      <h1>Не ищите игру.<br>Найдите свою.</h1>
      <p class="lead">GamePulse учитывает ваши оценки и вкусы похожих игроков, чтобы собрать личную подборку из <%= Game.count %> игр.</p>
      <div class="actions">
        <% if authenticated? %>
          <a href="/recommendations" class="button button-primary">Открыть мою подборку <i class="fa-solid fa-arrow-right"></i></a>
        <% else %>
          <a href="/registration/new" class="button button-primary">Собрать мою подборку <i class="fa-solid fa-arrow-right"></i></a>
          <a href="/session/new" class="button button-secondary">Попробовать демо</a>
        <% end %>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <% @games.first(2).each do |game| %>
        <img src="<%= game.image_url %>" alt="" class="hero-cover">
      <% end %>
    </div>
  </section>

  <section>
    <div class="section-heading">
      <div>
        <h2>Каталог видеоигр</h2>
        <p><%= Game.count %> игр · обложки, оценки и жанры</p>
      </div>
      <a href="/ui_kit" class="text-link">UI Kit <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
    </div>

    <div class="catalog-toolbar">
      <nav class="tab-list" aria-label="Сортировка каталога">
        <a href="<%= games_path(tab: 'all', sort: 'popular') %>" class="tab <%= 'active' if @sort == 'popular' %>">Популярные</a>
        <a href="<%= games_path(tab: 'all', sort: 'top_rated') %>" class="tab <%= 'active' if @sort == 'top_rated' %>">Высокий рейтинг</a>
        <a href="<%= games_path(tab: 'all', sort: 'recent') %>" class="tab <%= 'active' if @sort == 'recent' %>">Новые</a>
        <a href="<%= games_path(tab: 'all', sort: 'title') %>" class="tab <%= 'active' if @sort == 'title' %>">По названию</a>
      </nav>
    </div>

    <div class="filter-list" aria-label="Фильтр по жанрам">
      <a href="<%= games_path(tab: @tab, sort: @sort) %>" class="filter <%= 'active' if @selected_genre.nil? %>">Все жанры</a>
      <% @genres.each do |genre| %>
        <a href="<%= games_path(genre: genre.slug, tab: @tab, sort: @sort) %>" class="filter <%= 'active' if @selected_genre&.id == genre.id %>"><%= genre.name %></a>
      <% end %>
    </div>

    <% if @tab == 'recommended' && !authenticated? %>
      <div class="empty-state">
        <i class="fa-solid fa-gamepad"></i>
        <h3>Персональные рекомендации для вас</h3>
        <p>Войдите или выберите демо-профиль, чтобы собрать игры под ваш вкус</p>
        <div class="actions" style="justify-content:center"><a href="/session/new" class="button button-primary">Выбрать демо-профиль</a><a href="/registration/new" class="button button-secondary">Создать аккаунт</a></div>
      </div>
    <% elsif @games.any? %>
      <div class="game-grid">
        <% @games.each do |game| %>
          <% user_interaction = current_user&.interaction_for(game) %>
          <% rec = current_user&.user_recommendations&.find { |r| r.game_id == game.id } if @tab == 'recommended' %>
          <article class="game-card">
            <a href="<%= game_path(game) %>" class="game-cover">
              <img src="<%= game.image_url %>" alt="Обложка <%= game.title %>" loading="lazy">
              <span class="rating-badge"><i class="fa-solid fa-star"></i><%= game.average_rating %></span>
              <% if rec %>
                <span class="match-badge"><%= (rec.score * 100).round %>%</span>
              <% elsif user_interaction&.rating.present? %>
                <span class="match-badge"><%= user_interaction.rating %>/10</span>
              <% end %>
            </a>
            <div class="game-card-body">
              <a href="<%= game_path(game) %>" class="game-title"><%= game.title %></a>
              <% if rec && rec.reason.present? %>
                <p class="game-description"><%= rec.reason %></p>
              <% else %>
                <p class="game-description"><%= game.description %></p>
              <% end %>
              <div class="genre-list">
                <% game.genres.first(3).each do |genre| %><span class="genre"><%= genre.name %></span><% end %>
              </div>
              <div class="game-card-footer">
                <span><%= game.release_date&.year || "—" %> · <%= game.formatted_reviews_count %> оценок</span>
                <a href="<%= game_path(game) %>" class="card-link" aria-label="Подробнее о <%= game.title %>"><i class="fa-solid fa-arrow-right"></i></a>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <i class="fa-solid fa-magnifying-glass"></i>
        <h3>Таких игр не нашлось</h3>
        <p>Попробуйте другой запрос или сбросьте фильтр по жанру</p>
        <a href="<%= games_path(tab: 'all') %>" class="button button-primary">Показать все игры</a>
      </div>
    <% end %>
  </section>
</div>
