<div class="space-y-10">

  <!-- Hero Banner -->
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-purple-950/60 via-slate-900 to-indigo-950/60 border border-purple-900/30 p-8 sm:p-12 shadow-2xl">
    <div class="absolute -right-16 -top-16 w-80 h-80 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-16 -bottom-16 w-80 h-80 bg-indigo-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-900/50 border border-purple-700/50 text-purple-300 text-xs font-semibold uppercase tracking-wider mb-4">
        <i class="fa-solid fa-sparkles text-amber-400"></i> Гибридный алгоритм 4 сигналов
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
        Откройте игры, которые <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-400 to-indigo-400">подойдут именно вам</span>
      </h1>
      <p class="mt-4 text-base text-slate-300 leading-relaxed">
        Система подбирает игры по вашей истории оценок, любимым жанрам, оценкам похожих игроков и актуальности.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <% if authenticated? %>
          <a href="/recommendations" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold text-sm shadow-lg shadow-purple-600/30 transition-all">
            <i class="fa-solid fa-wand-magic-sparkles text-amber-300"></i> Мои рекомендации
          </a>
        <% else %>
          <a href="/registration/new" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold text-sm shadow-lg shadow-purple-600/30 transition-all">
            <i class="fa-solid fa-user-plus"></i> Начать подбор игр
          </a>
          <a href="/session/new" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700/80 text-slate-200 border border-slate-700 font-semibold text-sm transition-all">
            <i class="fa-solid fa-right-to-bracket"></i> Демо вход
          </a>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Catalog Section -->
  <div class="space-y-6">
    
    <!-- Catalog Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-white flex items-center gap-2.5">
          <i class="fa-solid fa-shapes text-purple-400"></i>
          Каталог видеоигр
        </h2>
        <p class="text-xs text-slate-400 mt-0.5">Всего в базе: <%= Game.count %> игр</p>
      </div>

      <% if @tab == 'recommended' && authenticated? %>
        <a href="/recommendations" class="text-xs font-semibold text-purple-400 hover:text-purple-300 flex items-center gap-1 shrink-0">
          Подробная статистика рекомендаций <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      <% end %>
    </div>

    <!-- Top Catalog Navigation Tabs -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-4">
      <div class="flex items-center gap-2 overflow-x-auto scrollbar-none">
        <a href="<%= games_path(tab: 'all') %>" 
           class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all flex items-center gap-2 shrink-0 <%= @tab == 'all' ? 'bg-purple-600 text-white shadow-lg shadow-purple-600/30' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800' %>">
          <i class="fa-solid fa-shapes"></i> Все игры (<%= Game.count %>)
        </a>

        <a href="<%= games_path(tab: 'recommended') %>" 
           class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all flex items-center gap-2 shrink-0 <%= @tab == 'recommended' ? 'bg-gradient-to-r from-purple-600 to-indigo-600 text-white shadow-lg shadow-purple-600/30 border border-purple-400/30' : 'bg-slate-900 text-amber-300/90 hover:text-amber-200 border border-amber-500/20 hover:border-amber-500/40' %>">
          <i class="fa-solid fa-wand-magic-sparkles text-amber-400"></i> Рекомендованные мне
          <span class="px-1.5 py-0.5 rounded text-[10px] bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold">New</span>
        </a>

        <a href="<%= games_path(tab: 'all', sort: 'popular') %>" 
           class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all flex items-center gap-2 shrink-0 <%= (@tab == 'all' && @sort == 'popular') ? 'bg-slate-800 text-white border border-slate-700' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800' %>">
          <i class="fa-solid fa-fire text-rose-400"></i> Популярные
        </a>

        <a href="<%= games_path(tab: 'all', sort: 'top_rated') %>" 
           class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all flex items-center gap-2 shrink-0 <%= (@tab == 'all' && @sort == 'top_rated') ? 'bg-slate-800 text-white border border-slate-700' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800' %>">
          <i class="fa-solid fa-star text-amber-400"></i> Топ рейтинг
        </a>

        <a href="<%= games_path(tab: 'all', sort: 'recent') %>" 
           class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all flex items-center gap-2 shrink-0 <%= (@tab == 'all' && @sort == 'recent') ? 'bg-slate-800 text-white border border-slate-700' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800' %>">
          <i class="fa-solid fa-bolt text-indigo-400"></i> Свежие
        </a>
      </div>

      <% if @tab == 'recommended' && authenticated? %>
        <a href="/recommendations" class="text-xs font-semibold text-purple-400 hover:text-purple-300 flex items-center gap-1 shrink-0">
          Подробная статистика рекомендаций <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      <% end %>
    </div>

    <!-- Genre Filter Pills -->
    <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
      <a href="<%= games_path(tab: @tab, sort: @sort) %>" 
         class="shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all <%= @selected_genre.nil? ? 'bg-slate-800 text-white border border-slate-700 shadow-sm' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800 hover:border-slate-700' %>">
        Все жанры
      </a>
      <% @genres.each do |genre| %>
        <a href="<%= games_path(genre: genre.slug, tab: @tab, sort: @sort) %>" 
           class="shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all <%= @selected_genre&.id == genre.id ? 'bg-purple-600 text-white shadow-md shadow-purple-600/30' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800 hover:border-slate-700' %>">
          <%= genre.name %>
        </a>
      <% end %>
    </div>

    <!-- Content for Recommended Tab when NOT logged in -->
    <% if @tab == 'recommended' && !authenticated? %>
      <div class="text-center py-16 bg-slate-900 border border-slate-800 rounded-3xl p-8 shadow-xl">
        <div class="w-16 h-16 mx-auto rounded-3xl bg-purple-950/60 border border-purple-800/60 flex items-center justify-center text-purple-300 text-2xl mb-4 shadow-lg shadow-purple-900/30">
          <i class="fa-solid fa-wand-magic-sparkles text-amber-400"></i>
        </div>
        <h3 class="text-xl font-bold text-white">Персональные рекомендации для вас</h3>
        <p class="text-xs sm:text-sm text-slate-400 mt-2 max-w-lg mx-auto leading-relaxed">
          Чтобы система подобрала игры под ваш вкус, войдите в аккаунт или выберите один из готовых тестовых профилей в один клик.
        </p>

        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="/session/new" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-semibold text-xs shadow-lg shadow-purple-600/30 hover:from-purple-500 hover:to-indigo-500 transition-all">
            Войти или выбрать демо-профиль
          </a>
          <a href="/registration/new" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs border border-slate-700 transition-all">
            Зарегистрироваться
          </a>
        </div>
      </div>

    <!-- Games Grid (Normal or Recommended) -->
    <% elsif @games.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        <% @games.each do |game| %>
          <% user_interaction = current_user&.interaction_for(game) %>
          <% rec = current_user&.user_recommendations&.find { |r| r.game_id == game.id } if @tab == 'recommended' %>

          <div class="group bg-slate-900 border border-slate-800 hover:border-purple-500/50 rounded-2xl overflow-hidden shadow-lg transition-all hover:-translate-y-1 hover:shadow-2xl hover:shadow-purple-950/20 flex flex-col">
            
            <!-- Poster -->
            <a href="<%= game_path(game) %>" class="relative aspect-[460/215] overflow-hidden bg-slate-950 block border-b border-slate-800/80">
              <img src="<%= game.image_url %>" class="absolute inset-0 w-full h-full object-cover blur-sm opacity-20 scale-110 pointer-events-none">
              <img src="<%= game.image_url %>" alt="<%= game.title %>" class="relative z-10 w-full h-full object-contain group-hover:scale-105 transition-transform duration-500">
              
              <!-- Badges -->
              <div class="absolute top-2.5 left-2.5 z-20 flex items-center gap-1.5">
                <span class="bg-black/75 backdrop-blur-md px-2 py-0.5 rounded-lg text-xs font-bold text-amber-300 border border-amber-500/30 flex items-center gap-1">
                  <i class="fa-solid fa-star text-[10px]"></i> <%= game.average_rating %>
                </span>
                <span class="bg-black/75 backdrop-blur-md px-2 py-0.5 rounded-lg text-[10px] text-slate-300 border border-slate-700">
                  <%= game.ratings_count %> оценок
                </span>
              </div>

              <% if rec %>
                <div class="absolute top-2.5 right-2.5 z-20 bg-gradient-to-r from-purple-600 to-indigo-600 px-2.5 py-0.5 rounded-lg text-xs font-extrabold text-white shadow-lg">
                  <%= (rec.score * 100).round %>% Match
                </div>
              <% elsif user_interaction&.rating.present? %>
                <div class="absolute top-2.5 right-2.5 z-20 bg-purple-600 px-2 py-0.5 rounded-lg text-xs font-bold text-white shadow">
                  Моя: <%= user_interaction.rating %>/10
                </div>
              <% end %>
            </a>

            <!-- Content -->
            <div class="p-4 flex-1 flex flex-col justify-between">
              <div>
                <a href="<%= game_path(game) %>" class="font-bold text-base text-white group-hover:text-purple-400 transition-colors line-clamp-1">
                  <%= game.title %>
                </a>
                
                <% if rec && rec.reason.present? %>
                  <div class="p-2 mt-2 rounded-xl bg-purple-950/40 border border-purple-800/40 text-[11px] text-purple-200 line-clamp-2">
                    <i class="fa-solid fa-circle-info text-[9px] mr-1 text-purple-400"></i><%= rec.reason %>
                  </div>
                <% else %>
                  <p class="text-xs text-slate-400 mt-1 line-clamp-2 leading-relaxed">
                    <%= game.description %>
                  </p>
                <% end %>

                <!-- Genres -->
                <div class="flex flex-wrap gap-1.5 mt-3">
                  <% game.genres.first(3).each do |g| %>
                    <span class="px-2 py-0.5 rounded-md bg-slate-800 text-[10px] font-medium text-slate-300">
                      <%= g.name %>
                    </span>
                  <% end %>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs">
                <span class="text-slate-400">
                  <%= game.release_date&.year || "—" %>
                </span>
                <a href="<%= game_path(game) %>" class="text-purple-400 group-hover:text-purple-300 font-semibold flex items-center gap-1">
                  Подробнее <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
              </div>
            </div>

          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16 bg-slate-900 border border-slate-800 rounded-2xl p-8">
        <i class="fa-solid fa-ghost text-4xl text-slate-600 mb-3"></i>
        <h3 class="text-lg font-bold text-white">Игры не найдены</h3>
        <p class="text-xs text-slate-400 mt-1">
          <% if @tab == 'recommended' %>
            Вы еще не оценили достаточно игр. Оцените пару игр в каталоге, чтобы получить подборку!
          <% else %>
            Попробуйте изменить запрос поиска или выбранный жанр
          <% end %>
        </p>
        <a href="<%= games_path(tab: 'all') %>" class="mt-4 inline-block px-4 py-2 rounded-xl bg-purple-600 text-xs font-semibold text-white">Перейти ко всем играм</a>
      </div>
    <% end %>

  </div>

</div>
