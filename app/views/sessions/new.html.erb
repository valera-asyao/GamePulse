<div class="auth-wrap">
  <section class="auth-panel">
    <div class="auth-head"><p class="eyebrow">С возвращением</p><h1>Вход в GamePulse</h1><p>Ваша игровая история и подборки на месте</p></div>
    <%= form_with url: session_path, method: :post, class: "form-stack", id: "login_form" do |f| %>
      <div class="field"><label>Email</label><%= f.email_field :email_address, id: "login_email", required: true, autofocus: true, autocomplete: "username", placeholder: "alex@example.com", class: "input" %></div>
      <div class="field"><label>Пароль</label><%= f.password_field :password, id: "login_password", required: true, autocomplete: "current-password", placeholder: "Ваш пароль", class: "input" %></div>
      <%= f.submit "Войти", class: "button button-primary" %>
    <% end %>
    <div class="auth-foot" style="text-align:left">
      <p style="margin-bottom:12px">Быстрый вход с демо-профилем</p>
      <div class="demo-list">
        <button type="button" onclick="fillLogin('alex@example.com', 'password123')" class="demo-button"><strong>Александр</strong><span>RPG и открытые миры</span></button>
        <button type="button" onclick="fillLogin('elena@example.com', 'password123')" class="demo-button"><strong>Елена</strong><span>Инди и атмосферные игры</span></button>
        <button type="button" onclick="fillLogin('dmitry@example.com', 'password123')" class="demo-button"><strong>Дмитрий</strong><span>Экшен и сложные боссы</span></button>
        <button type="button" onclick="fillLogin('artem@example.com', 'password123')" class="demo-button"><strong>Артем</strong><span>Стратегии и тактика</span></button>
      </div>
    </div>
    <p class="auth-foot">Впервые здесь? <a href="/registration/new">Создать аккаунт</a></p>
  </section>
</div>
<script>
  function fillLogin(email, password) {
    document.getElementById('login_email').value = email;
    document.getElementById('login_password').value = password;
    document.getElementById('login_form').submit();
  }
</script>
