<div class="max-w-md mx-auto my-6">
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-sm">
    <div class="text-center mb-6">
      <div class="w-10 h-10 mx-auto rounded-xl bg-indigo-600 flex items-center justify-center text-white text-base shadow-sm mb-3">
        <i class="fa-solid fa-user-plus"></i>
      </div>
      <h1 class="text-xl font-bold text-white tracking-tight">Создать аккаунт</h1>
      <p class="text-xs text-slate-400 mt-1">Присоединяйтесь для получения умных рекомендаций</p>
    </div>

    <% if @user.errors.any? %>
      <div class="mb-5 p-3.5 rounded-lg bg-rose-950/70 border border-rose-800/60 text-rose-200 text-xs">
        <div class="font-medium mb-1 flex items-center gap-1.5">
          <i class="fa-solid fa-circle-exclamation"></i>
          Ошибки при заполнении:
        </div>
        <ul class="list-disc list-inside space-y-0.5 text-slate-300">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: registration_path, method: :post, class: "space-y-3.5" do |f| %>
      <div>
        <label class="block text-xs font-medium text-slate-300 mb-1">Email <span class="text-rose-400">*</span></label>
        <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "gamer@example.com",
            class: "w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors" %>
      </div>

      <div>
        <label class="block text-xs font-medium text-slate-300 mb-1">Никнейм (username) <span class="text-rose-400">*</span></label>
        <%= f.text_field :username, required: true, placeholder: "cyber_hero",
            class: "w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors" %>
      </div>

      <div>
        <label class="block text-xs font-medium text-slate-300 mb-1">Отображаемое имя</label>
        <%= f.text_field :name, placeholder: "Алексей Иванов",
            class: "w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors" %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Пароль <span class="text-rose-400">*</span></label>
          <%= f.password_field :password, required: true, autocomplete: "new-password", placeholder: "••••••••",
              class: "w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors" %>
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Повтор пароля <span class="text-rose-400">*</span></label>
          <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "••••••••",
              class: "w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors" %>
        </div>
      </div>

      <div>
        <label class="block text-xs font-medium text-slate-300 mb-1">О себе</label>
        <%= f.text_area :bio, rows: 2, placeholder: "Фанат RPG и пошаговых стратегий...",
            class: "w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-1.5 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors" %>
      </div>

      <div class="pt-1.5">
        <%= f.submit "Зарегистрироваться", class: "w-full py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm transition-colors cursor-pointer shadow-sm" %>
      </div>
    <% end %>

    <div class="mt-5 pt-4 border-t border-slate-800 text-center text-xs text-slate-400">
      Уже есть аккаунт?
      <a href="/session/new" class="text-indigo-400 hover:text-indigo-300 font-medium ml-1">Войти</a>
    </div>
  </div>
</div>
