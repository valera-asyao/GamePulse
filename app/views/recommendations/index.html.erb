<div class="page-stack">
  <section>
    <div class="recommendation-head">
      <div>
        <p class="eyebrow">Подборка для <%= @user.display_name %></p>
        <h1>Игры под ваш вкус</h1>
        <p class="lead">Собрали эту подборку по вашим оценкам, интересам и вкусам похожих игроков</p>
      </div>
      <%= button_to refresh_recommendations_path, method: :post, class: "button button-secondary", data: { turbo: true } do %>
        <i class="fa-solid fa-arrows-rotate"></i><span>Обновить подборку</span>
      <% end %>
    </div>

    <div class="formula" aria-label="Как рассчитываются рекомендации">
      <div class="formula-item"><div class="formula-value">40%</div><h3>Ваши жанры</h3><p>Совпадение жанров, тегов и механик</p></div>
      <div class="formula-item"><div class="formula-value">30%</div><h3>Похожие игроки</h3><p>Оценки людей с близкими вкусами</p></div>
      <div class="formula-item"><div class="formula-value">20%</div><h3>Признание</h3><p>Рейтинг и популярность игры</p></div>
      <div class="formula-item"><div class="formula-value">10%</div><h3>Новизна</h3><p>Дата выхода и актуальность</p></div>
    </div>
  </section>

  <%= render partial: "recommendations/list", locals: { recommendations: @recommendations } %>
</div>
