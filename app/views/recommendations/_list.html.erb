<div id="recommendations_container" class="space-y-5">
  <% if recommendations.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <% recommendations.each_with_index do |rec, index| %>
        <% game = rec.game %>
        <div class="bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-xl p-5 shadow-sm transition-all flex flex-col justify-between group">
          
          <div>
            <!-- Header: Title, Rank, Match % -->
            <div class="flex items-start justify-between gap-3 mb-3">
              <div class="flex items-center gap-2.5">
                <span class="w-7 h-7 rounded-lg bg-slate-800 text-indigo-400 font-bold text-xs flex items-center justify-center shrink-0">
                  #<%= index + 1 %>
                </span>
                <div>
                  <a href="<%= game_path(game) %>" class="font-semibold text-sm sm:text-base text-white group-hover:text-indigo-400 transition-colors">
                    <%= game.title %>
                  </a>
                  <div class="text-[11px] text-slate-400">
                    <%= game.release_date&.year %> • <%= game.genres.map(&:name).join(', ') %>
                  </div>
                </div>
              </div>

              <div class="text-right shrink-0">
                <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-indigo-600/20 border border-indigo-500/30 text-indigo-300 font-semibold text-xs">
                  <i class="fa-solid fa-chart-line text-[10px]"></i> <%= (rec.score * 100).round %>% Match
                </div>
              </div>
            </div>

            <!-- Poster and Explanation -->
            <div class="flex flex-col sm:flex-row gap-3.5 my-3">
              <a href="<%= game_path(game) %>" class="shrink-0 w-full sm:w-44 aspect-[460/215] rounded-lg overflow-hidden bg-slate-950 border border-slate-800 relative block shadow-sm self-start">
                <img src="<%= game.image_url %>" class="absolute inset-0 w-full h-full object-cover blur-sm opacity-20 scale-110 pointer-events-none">
                <img src="<%= game.image_url %>" alt="<%= game.title %>" class="relative z-10 w-full h-full object-contain group-hover:scale-102 transition-transform duration-300">
                <div class="absolute top-1.5 left-1.5 z-20 bg-black/80 px-2 py-0.5 rounded text-[10px] font-semibold text-amber-300 border border-slate-750">
                  ★ <%= game.average_rating %>
                </div>
              </a>

              <div class="flex-1 flex flex-col justify-between text-xs space-y-2">
                <!-- Explanation Reason Badge -->
                <div class="p-2.5 rounded-lg bg-slate-850 border border-slate-800 text-slate-300">
                  <div class="text-[10px] font-semibold uppercase tracking-wider text-indigo-400 mb-0.5 flex items-center gap-1.5">
                    <i class="fa-solid fa-brain"></i> Почему мы рекомендуем:
                  </div>
                  <p class="text-xs leading-relaxed text-slate-300"><%= rec.reason %></p>
                </div>

                <!-- 4 Signals Breakdown -->
                <div class="space-y-1.5 pt-1 text-[10px]">
                  <div>
                    <div class="flex justify-between text-slate-400 mb-0.5">
                      <span>Жанры & Теги (40%)</span>
                      <span class="text-slate-200 font-medium"><%= (rec.genre_score * 100).round %>%</span>
                    </div>
                    <div class="w-full h-1 bg-slate-800 rounded-full overflow-hidden">
                      <div class="h-full bg-indigo-500 rounded-full" style="width: <%= [rec.genre_score * 100, 100].min %>%"></div>
                    </div>
                  </div>

                  <div>
                    <div class="flex justify-between text-slate-400 mb-0.5">
                      <span>Похожие игроки (30%)</span>
                      <span class="text-slate-200 font-medium"><%= (rec.collaborative_score * 100).round %>%</span>
                    </div>
                    <div class="w-full h-1 bg-slate-800 rounded-full overflow-hidden">
                      <div class="h-full bg-indigo-400 rounded-full" style="width: <%= [rec.collaborative_score * 100, 100].min %>%"></div>
                    </div>
                  </div>

                  <div>
                    <div class="flex justify-between text-slate-400 mb-0.5">
                      <span>Популярность (20%)</span>
                      <span class="text-slate-200 font-medium"><%= (rec.popularity_score * 100).round %>%</span>
                    </div>
                    <div class="w-full h-1 bg-slate-800 rounded-full overflow-hidden">
                      <div class="h-full bg-amber-400 rounded-full" style="width: <%= [rec.popularity_score * 100, 100].min %>%"></div>
                    </div>
                  </div>
                </div>

              </div>
            </div>

          </div>

          <!-- Actions -->
          <div class="mt-2.5 pt-2.5 border-t border-slate-800 flex items-center justify-between text-xs">
            <span class="text-[11px] text-slate-400">
              <i class="fa-solid fa-users text-slate-500 mr-1"></i> <%= game.ratings_count %> отзывов
            </span>
            <a href="<%= game_path(game) %>" class="px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-xs transition-colors">
              Перейти к игре →
            </a>
          </div>

        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 bg-slate-900 border border-slate-800 rounded-2xl p-8">
      <div class="w-12 h-12 mx-auto rounded-xl bg-slate-800 flex items-center justify-center text-slate-400 text-xl mb-3">
        <i class="fa-solid fa-gamepad"></i>
      </div>
      <h3 class="text-base font-bold text-white">Рекомендаций пока нет</h3>
      <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">
        Поставьте оценки 2-3 играм в каталоге, чтобы алгоритм изучил ваши игровые вкусы.
      </p>
      <a href="/" class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-medium transition-colors">
        <i class="fa-solid fa-shapes"></i> Перейти в каталог
      </a>
    </div>
  <% end %>
</div>
