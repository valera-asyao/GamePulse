<div id="recommendations_container" class="space-y-6">
  <% if recommendations.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% recommendations.each_with_index do |rec, index| %>
        <% game = rec.game %>
        <div class="bg-slate-900 border border-slate-800 hover:border-purple-500/50 rounded-3xl p-5 shadow-xl transition-all flex flex-col justify-between group">
          
          <div>
            <!-- Header: Title, Rank, Match % -->
            <div class="flex items-start justify-between gap-3 mb-3">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-xl bg-purple-950 border border-purple-800 text-purple-300 font-extrabold text-xs flex items-center justify-center shrink-0">
                  #<%= index + 1 %>
                </span>
                <div>
                  <a href="<%= game_path(game) %>" class="font-bold text-base text-white group-hover:text-purple-400 transition-colors">
                    <%= game.title %>
                  </a>
                  <div class="text-[11px] text-slate-400">
                    <%= game.release_date&.year %> • <%= game.genres.map(&:name).join(', ') %>
                  </div>
                </div>
              </div>

              <div class="text-right shrink-0">
                <div class="inline-flex items-center gap-1 px-3 py-1 rounded-xl bg-gradient-to-r from-purple-900/60 to-indigo-900/60 border border-purple-700/50 text-purple-300 font-bold text-xs shadow-inner">
                  <i class="fa-solid fa-chart-line text-[10px]"></i> <%= (rec.score * 100).round %>% Match
                </div>
              </div>
            </div>

            <!-- Poster and AI Explanation -->
            <div class="flex flex-col sm:flex-row gap-4 my-3">
              <a href="<%= game_path(game) %>" class="shrink-0 w-full sm:w-44 aspect-[460/215] rounded-2xl overflow-hidden bg-slate-950 border border-slate-800/80 relative block shadow-lg self-start">
                <img src="<%= game.image_url %>" class="absolute inset-0 w-full h-full object-cover blur-sm opacity-20 scale-110 pointer-events-none">
                <img src="<%= game.image_url %>" alt="<%= game.title %>" class="relative z-10 w-full h-full object-contain group-hover:scale-105 transition-transform duration-300">
                <div class="absolute top-2 left-2 z-20 bg-black/80 px-2 py-0.5 rounded-lg text-[10px] font-bold text-amber-300 border border-amber-500/20">
                  ★ <%= game.average_rating %>
                </div>
              </a>

              <div class="flex-1 flex flex-col justify-between text-xs">
                <!-- Explanation Reason Badge -->
                <div class="p-3 rounded-xl bg-purple-950/40 border border-purple-800/40 text-purple-200">
                  <div class="text-[10px] font-bold uppercase tracking-wider text-purple-400 mb-1 flex items-center gap-1.5">
                    <i class="fa-solid fa-brain"></i> Почему мы рекомендуем:
                  </div>
                  <p class="text-xs leading-relaxed"><%= rec.reason %></p>
                </div>

                <!-- 4 Signals Breakdown -->
                <div class="mt-2 space-y-1.5 pt-2 border-t border-slate-800 text-[10px]">
                  <div>
                    <div class="flex justify-between text-slate-400 mb-0.5">
                      <span>Жанры & Теги (40%)</span>
                      <span class="text-slate-200 font-bold"><%= (rec.genre_score * 100).round %>%</span>
                    </div>
                    <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden">
                      <div class="h-full bg-purple-500 rounded-full" style="width: <%= [rec.genre_score * 100, 100].min %>%"></div>
                    </div>
                  </div>

                  <div>
                    <div class="flex justify-between text-slate-400 mb-0.5">
                      <span>Похожие игроки (30%)</span>
                      <span class="text-slate-200 font-bold"><%= (rec.collaborative_score * 100).round %>%</span>
                    </div>
                    <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden">
                      <div class="h-full bg-indigo-500 rounded-full" style="width: <%= [rec.collaborative_score * 100, 100].min %>%"></div>
                    </div>
                  </div>

                  <div>
                    <div class="flex justify-between text-slate-400 mb-0.5">
                      <span>Популярность (20%)</span>
                      <span class="text-slate-200 font-bold"><%= (rec.popularity_score * 100).round %>%</span>
                    </div>
                    <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden">
                      <div class="h-full bg-amber-500 rounded-full" style="width: <%= [rec.popularity_score * 100, 100].min %>%"></div>
                    </div>
                  </div>
                </div>

              </div>
            </div>

          </div>

          <!-- Actions -->
          <div class="mt-3 pt-3 border-t border-slate-800 flex items-center justify-between">
            <span class="text-[11px] text-slate-400">
              <i class="fa-solid fa-users text-indigo-400 mr-1"></i> <%= game.ratings_count %> отзывов
            </span>
            <a href="<%= game_path(game) %>" class="px-4 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold text-xs shadow-md transition-all">
              Перейти к игре →
            </a>
          </div>

        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 bg-slate-900 border border-slate-800 rounded-3xl p-8">
      <div class="w-16 h-16 mx-auto rounded-3xl bg-slate-800 flex items-center justify-center text-slate-500 text-2xl mb-4">
        <i class="fa-solid fa-gamepad"></i>
      </div>
      <h3 class="text-lg font-bold text-white">Рекомендаций пока нет</h3>
      <p class="text-xs text-slate-400 mt-1 max-w-md mx-auto">
        Поставьте оценки 2-3 играм в каталоге, чтобы алгоритм изучил ваши игровые предпочтения и построил персональный профиль!
      </p>
      <a href="/" class="mt-4 inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold shadow-lg">
        <i class="fa-solid fa-shapes"></i> Перейти в каталог и оценить
      </a>
    </div>
  <% end %>
</div>
