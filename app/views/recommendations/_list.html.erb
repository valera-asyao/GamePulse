<section id="recommendations_container">
  <% if recommendations.any? %>
    <div class="section-heading">
      <div><h2>Ваша очередь на игру</h2><p><%= recommendations.count %> рекомендаций, от наиболее подходящей</p></div>
    </div>
    <div class="recommendation-list">
      <% recommendations.each_with_index do |rec, index| %>
        <% game = rec.game %>
        <article class="recommendation-card">
          <span class="rank"><%= format('%02d', index + 1) %></span>
          <a href="<%= game_path(game) %>"><img src="<%= game.image_url %>" alt="Обложка <%= game.title %>" class="recommendation-cover" loading="lazy"></a>
          <div class="recommendation-info">
            <a href="<%= game_path(game) %>"><h3><%= game.title %></h3></a>
            <div class="recommendation-meta"><%= game.release_date&.year %> · <%= game.genres.map(&:name).join(', ') %> · <i class="fa-solid fa-star"></i> <%= game.average_rating %></div>
            <p class="recommendation-reason"><%= rec.reason %></p>
            <div class="signal-bars" title="Жанры: <%= (rec.genre_score * 100).round %>%, похожие игроки: <%= (rec.collaborative_score * 100).round %>%, популярность: <%= (rec.popularity_score * 100).round %>%">
              <span class="signal-bar" style="width: <%= [rec.genre_score * 40, 40].min %>%"></span>
              <span class="signal-bar" style="width: <%= [rec.collaborative_score * 30, 30].min %>%"></span>
              <span class="signal-bar" style="width: <%= [rec.popularity_score * 20, 20].min %>%"></span>
            </div>
          </div>
          <div class="recommendation-score"><strong><%= (rec.score * 100).round %>%</strong><span>совпадение</span></div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <i class="fa-solid fa-gamepad"></i>
      <h2>Подборка ждёт первых оценок</h2>
      <p>Оцените две или три игры в каталоге, чтобы мы поняли ваши вкусы</p>
      <a href="/" class="button button-primary">Выбрать игры</a>
    </div>
  <% end %>
</section>
