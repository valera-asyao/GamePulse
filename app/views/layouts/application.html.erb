<!DOCTYPE html>
<html lang="ru" class="dark">
  <head>
    <title><%= content_for(:title) || "GamePulse — Рекомендательная система игр" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              brand: {
                50: '#f5f3ff',
                100: '#ede9fe',
                500: '#8b5cf6',
                600: '#7c3aed',
                700: '#6d28d9',
                800: '#5b21b6',
                900: '#4c1d95',
              }
            }
          }
        }
      }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans selection:bg-indigo-600 selection:text-white antialiased">
    <!-- Navigation Bar -->
    <header class="sticky top-0 z-50 bg-slate-900/95 backdrop-blur border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        
        <!-- Logo & Navigation Links -->
        <div class="flex items-center gap-6 sm:gap-8">
          <a href="/" class="flex items-center gap-2.5 group">
            <div class="w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center text-white shadow-sm transition-transform group-hover:scale-105">
              <i class="fa-solid fa-gamepad text-base"></i>
            </div>
            <span class="text-lg font-bold tracking-tight text-white group-hover:text-indigo-400 transition-colors">GamePulse</span>
          </a>

          <!-- Main Nav Tabs -->
          <nav class="hidden md:flex items-center gap-1.5">
            <a href="/" class="px-3 py-1.5 text-sm font-medium rounded-lg transition-colors flex items-center gap-2 <%= (request.path == '/' || (request.path == '/games' && params[:tab] != 'recommended')) ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-850' %>">
              <i class="fa-solid fa-shapes text-indigo-400 text-xs"></i> Каталог
            </a>
            <a href="/recommendations" class="px-3 py-1.5 text-sm font-medium rounded-lg transition-colors flex items-center gap-2 <%= request.path.start_with?('/recommendations') ? 'bg-indigo-600/20 text-indigo-300 border border-indigo-500/30' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-850' %>">
              <i class="fa-solid fa-wand-magic-sparkles text-amber-400 text-xs"></i> Рекомендации
            </a>
            <a href="/ui_kit" class="px-3 py-1.5 text-sm font-medium rounded-lg transition-colors flex items-center gap-2 <%= request.path == '/ui_kit' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-850' %>">
              <i class="fa-solid fa-palette text-emerald-400 text-xs"></i> UI Kit
            </a>
          </nav>
        </div>

        <!-- Search Bar -->
        <div class="flex-1 max-w-sm hidden sm:block">
          <form action="/games" method="get" class="relative">
            <input type="text" name="q" value="<%= params[:q] %>" placeholder="Поиск игры или жанра..." 
                   class="w-full bg-slate-900 text-sm text-slate-200 placeholder-slate-500 rounded-lg pl-9 pr-3.5 py-1.5 border border-slate-800 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-500 text-xs"></i>
          </form>
        </div>

        <!-- Auth Controls -->
        <div class="flex items-center gap-2.5">
          <% if authenticated? %>
            <div class="flex items-center gap-2.5">
              <a href="/profile" class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg bg-slate-850 hover:bg-slate-800 border border-slate-800 text-xs sm:text-sm text-slate-200 transition-colors">
                <% if current_user.avatar_image_url.present? %>
                  <img src="<%= current_user.avatar_image_url %>" alt="<%= current_user.display_name %>" class="w-6 h-6 rounded-md object-cover">
                <% else %>
                  <div class="w-6 h-6 rounded-md bg-indigo-600 flex items-center justify-center font-bold text-xs text-white">
                    <%= current_user.display_name.first.upcase rescue "U" %>
                  </div>
                <% end %>
                <span class="font-medium hidden sm:inline"><%= current_user.display_name %></span>
              </a>

              <%= button_to session_path, method: :delete, class: "p-2 rounded-lg text-slate-400 hover:text-rose-400 hover:bg-slate-800 transition-colors text-sm", title: "Выйти" do %>
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
              <% end %>
            </div>
          <% else %>
            <div class="flex items-center gap-2">
              <a href="/session/new" class="px-3 py-1.5 text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-colors">
                Войти
              </a>
              <a href="/registration/new" class="px-3.5 py-1.5 text-sm font-medium bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg shadow-sm transition-colors">
                Регистрация
              </a>
            </div>
          <% end %>
        </div>

      </div>
    </header>

    <!-- Flash notifications -->
    <% if notice.present? %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 w-full">
        <div class="bg-emerald-950/80 border border-emerald-700/60 text-emerald-200 px-4 py-3 rounded-xl flex items-center justify-between text-sm shadow-lg">
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-circle-check text-emerald-400"></i>
            <span><%= notice %></span>
          </div>
          <button onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-emerald-200 text-xs">✕</button>
        </div>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 w-full">
        <div class="bg-rose-950/80 border border-rose-700/60 text-rose-200 px-4 py-3 rounded-xl flex items-center justify-between text-sm shadow-lg">
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-triangle-exclamation text-rose-400"></i>
            <span><%= alert %></span>
          </div>
          <button onclick="this.parentElement.remove()" class="text-rose-400 hover:text-rose-200 text-xs">✕</button>
        </div>
      </div>
    <% end %>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 border-t border-slate-800 mt-16 py-8 text-slate-400 text-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="font-bold text-slate-200 text-sm">GamePulse</span>
          <span>•</span>
          <span>Рекомендательная система видеоигр</span>
        </div>
        <div class="flex items-center gap-4 text-xs">
          <a href="/" class="hover:text-slate-200 transition-colors">Каталог</a>
          <a href="/recommendations" class="hover:text-slate-200 transition-colors">Рекомендации</a>
          <a href="/ui_kit" class="text-indigo-400 hover:text-indigo-300 font-medium transition-colors">UI Kit</a>
          <a href="https://github.com/valera-asyao/GamePulse" target="_blank" rel="noopener noreferrer" class="hover:text-slate-200 transition-colors flex items-center gap-1">
            <i class="fa-brands fa-github"></i> GitHub
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
