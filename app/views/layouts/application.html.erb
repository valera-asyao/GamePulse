<!DOCTYPE html>
<html lang="ru" class="dark">
  <head>
    <title><%= content_for(:title) || "GamePulse — Рекомендательная система игр" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              brand: {
                50: '#f5f3ff',
                100: '#ede9fe',
                500: '#8b5cf6',
                600: '#7c3aed',
                700: '#6d28d9',
                800: '#5b21b6',
                900: '#4c1d95',
              }
            }
          }
        }
      }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans selection:bg-purple-600 selection:text-white">
    <!-- Navigation Bar -->
    <header class="sticky top-0 z-50 bg-slate-900/90 backdrop-blur-md border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        
        <!-- Logo & Navigation Links -->
        <div class="flex items-center gap-8">
          <a href="/" class="flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 to-indigo-500 flex items-center justify-center text-white shadow-lg shadow-purple-500/25 group-hover:scale-105 transition-transform">
              <i class="fa-solid fa-gamepad text-lg"></i>
            </div>
            <div>
              <span class="text-xl font-black tracking-tight text-white group-hover:text-purple-400 transition-colors">GamePulse</span>
            </div>
          </a>

          <!-- Main Nav Tabs -->
          <nav class="hidden md:flex items-center gap-2">
            <a href="/" class="px-3.5 py-2 text-sm font-medium rounded-xl transition-all flex items-center gap-2 <%= (request.path == '/' || (request.path == '/games' && params[:sort] != 'recommended')) ? 'bg-slate-800 text-white border border-slate-700 shadow-sm' : 'text-slate-300 hover:text-white hover:bg-slate-800/60' %>">
              <i class="fa-solid fa-shapes text-purple-400"></i> Каталог игр
            </a>
            <a href="/recommendations" class="px-3.5 py-2 text-sm font-medium rounded-xl transition-all flex items-center gap-2 <%= request.path.start_with?('/recommendations') ? 'bg-gradient-to-r from-purple-600/30 to-indigo-600/30 text-purple-200 border border-purple-500/50 shadow-md shadow-purple-500/10' : 'text-slate-300 hover:text-white hover:bg-slate-800/60' %>">
              <i class="fa-solid fa-wand-magic-sparkles text-amber-400"></i> Рекомендации
              <span class="px-1.5 py-0.2 text-[10px] uppercase font-bold rounded bg-amber-500/20 text-amber-300 border border-amber-500/30">Топ</span>
            </a>
          </nav>
        </div>

        <!-- Search Bar -->
        <div class="flex-1 max-w-md hidden sm:block">
          <form action="/games" method="get" class="relative">
            <input type="text" name="q" value="<%= params[:q] %>" placeholder="Поиск игры, жанра или описания..." 
                   class="w-full bg-slate-800/90 text-sm text-slate-200 placeholder-slate-400 rounded-xl pl-10 pr-4 py-2 border border-slate-700 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-slate-400 text-xs"></i>
          </form>
        </div>

        <!-- Auth Controls -->
        <div class="flex items-center gap-3">
          <% if authenticated? %>
            <div class="flex items-center gap-3">
              <a href="/profile" class="flex items-center gap-2.5 px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700/80 border border-slate-700 text-sm text-slate-200 transition-colors">
                <% if current_user.avatar_image_url.present? %>
                  <img src="<%= current_user.avatar_image_url %>" alt="<%= current_user.display_name %>" class="w-7 h-7 rounded-lg object-cover border border-purple-500/60">
                <% else %>
                  <div class="w-7 h-7 rounded-lg bg-gradient-to-tr from-purple-500 to-pink-500 flex items-center justify-center font-bold text-xs text-white">
                    <%= current_user.display_name.first.upcase rescue "U" %>
                  </div>
                <% end %>
                <span class="font-medium hidden sm:inline"><%= current_user.display_name %></span>
              </a>

              <%= button_to session_path, method: :delete, class: "p-2 rounded-xl text-slate-400 hover:text-rose-400 hover:bg-slate-800 border border-transparent hover:border-slate-700 transition-colors text-sm", title: "Выйти" do %>
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
              <% end %>
            </div>
          <% else %>
            <div class="flex items-center gap-2">
              <a href="/session/new" class="px-3.5 py-1.5 text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800 rounded-xl transition-colors">
                Войти
              </a>
              <a href="/registration/new" class="px-3.5 py-1.5 text-sm font-medium bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white rounded-xl shadow-md shadow-purple-600/30 transition-all">
                Регистрация
              </a>
            </div>
          <% end %>
        </div>

      </div>
    </header>

    <!-- Flash notifications -->
    <% if notice.present? %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 w-full">
        <div class="bg-emerald-950/80 border border-emerald-700/60 text-emerald-200 px-4 py-3 rounded-xl flex items-center justify-between text-sm shadow-lg">
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-circle-check text-emerald-400"></i>
            <span><%= notice %></span>
          </div>
          <button onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-emerald-200 text-xs">✕</button>
        </div>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 w-full">
        <div class="bg-rose-950/80 border border-rose-700/60 text-rose-200 px-4 py-3 rounded-xl flex items-center justify-between text-sm shadow-lg">
          <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-triangle-exclamation text-rose-400"></i>
            <span><%= alert %></span>
          </div>
          <button onclick="this.parentElement.remove()" class="text-rose-400 hover:text-rose-200 text-xs">✕</button>
        </div>
      </div>
    <% end %>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <!-- Footer without algorithm explanation -->
    <footer class="bg-slate-900 border-t border-slate-800 mt-16 py-8 text-slate-400 text-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="font-bold text-slate-200 text-sm">GamePulse</span>
          <span>•</span>
          <span>Рекомендательная система видеоигр</span>
        </div>
        <div class="text-slate-500">
          © <%= Time.current.year %> GamePulse. Все права защищены.
        </div>
      </div>
    </footer>
  </body>
</html>
