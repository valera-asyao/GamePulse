<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "GamePulse — Рекомендательная система игр" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a href="/" class="brand" aria-label="GamePulse — на главную">
          <svg class="brand-mark" viewBox="0 0 28 20" fill="none" aria-hidden="true"><path d="M8 4h12c3 0 5 2 6 5l1 5c1 4-3 5-5 3l-4-4h-8l-4 4c-2 2-6 1-5-3l1-5c1-3 3-5 6-5Z" stroke="currentColor" stroke-width="1.5"/><path d="M8 7v5M5.5 9.5h5M20 8h.01M23 11h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span>GamePulse</span>
        </a>

        <nav class="main-nav" aria-label="Основная навигация">
          <a href="/" class="nav-link <%= 'active' if request.path == '/' || request.path == '/games' %>">Каталог</a>
          <a href="/recommendations" class="nav-link <%= 'active' if request.path.start_with?('/recommendations') %>">Для вас</a>
        </nav>

        <form action="/games" method="get" class="header-search" role="search">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <input type="search" name="q" value="<%= params[:q] %>" placeholder="Найти игру" aria-label="Найти игру">
        </form>

        <div class="account-controls">
          <% if authenticated? %>
            <a href="/profile" class="profile-link <%= 'active' if request.path.start_with?('/profile') %>">
              <% if current_user.avatar_image_url.present? %>
                <img src="<%= current_user.avatar_image_url %>" alt="" class="avatar avatar-small">
              <% else %>
                <span class="avatar avatar-small avatar-fallback"><%= current_user.display_name.first.upcase rescue "U" %></span>
              <% end %>
              <span class="profile-name"><%= current_user.display_name %></span>
            </a>
            <%= button_to session_path, method: :delete, class: "icon-button", title: "Выйти", "aria-label": "Выйти" do %>
              <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
            <% end %>
          <% else %>
            <a href="/session/new" class="text-link">Войти</a>
            <a href="/registration/new" class="button button-primary button-small">Регистрация</a>
          <% end %>
        </div>
      </div>
    </header>

    <% if notice.present? || alert.present? %>
      <div class="shell flash-wrap">
        <% if notice.present? %>
          <div class="flash flash-notice" role="status">
            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
            <span><%= notice %></span>
            <button onclick="this.parentElement.remove()" aria-label="Закрыть"><i class="fa-solid fa-xmark"></i></button>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="flash flash-alert" role="alert">
            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
            <span><%= alert %></span>
            <button onclick="this.parentElement.remove()" aria-label="Закрыть"><i class="fa-solid fa-xmark"></i></button>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="shell main-content"><%= yield %></main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <div><span class="footer-brand">GamePulse</span><span>Игры, которые подходят именно вам</span></div>
        <nav aria-label="Навигация в подвале">
          <a href="/">Каталог</a>
          <a href="/recommendations">Для вас</a>
          <a href="https://github.com/valera-asyao/GamePulse" target="_blank" rel="noopener noreferrer">GitHub <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
        </nav>
      </div>
    </footer>
  </body>
</html>
