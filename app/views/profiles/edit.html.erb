<div class="max-w-2xl mx-auto my-6">
  <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl">
    <div class="text-center mb-8">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Редактировать профиль</h1>
      <p class="text-xs text-slate-400 mt-1">Настройте внешний вид профиля и фото</p>
    </div>

    <%= form_with model: @user, url: profile_path, method: :patch, multipart: true, class: "space-y-6" do |f| %>
      
      <!-- Avatar Section -->
      <div class="p-5 rounded-2xl bg-slate-800/60 border border-slate-750 space-y-4">
        <label class="block text-xs font-bold uppercase tracking-wider text-purple-400 flex items-center gap-2">
          <i class="fa-solid fa-camera"></i> Фото профиля (Аватар)
        </label>

        <!-- Current Preview -->
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 rounded-2xl overflow-hidden bg-slate-800 border-2 border-purple-500/60 flex items-center justify-center shadow-lg shrink-0">
            <% if @user.avatar_image_url.present? %>
              <img id="avatar_preview" src="<%= @user.avatar_image_url %>" alt="<%= @user.display_name %>" class="w-full h-full object-cover">
            <% else %>
              <div id="avatar_preview_placeholder" class="font-bold text-xl text-white">
                <%= @user.display_name.first.upcase rescue "U" %>
              </div>
              <img id="avatar_preview" src="" alt="Preview" class="w-full h-full object-cover hidden">
            <% end %>
          </div>
          <div class="text-xs text-slate-300">
            <span class="font-semibold text-white">Текущий аватар</span>
            <p class="text-[11px] text-slate-400 mt-0.5">Выберите готовый аватар из галереи ниже, загрузите файл с устройства или укажите ссылку.</p>
          </div>
        </div>

        <!-- Preset Avatars Grid -->
        <div>
          <div class="text-xs font-medium text-slate-300 mb-2">Выберите из коллекции персонажей:</div>
          <div class="grid grid-cols-4 sm:grid-cols-8 gap-2.5">
            <% User::PRESET_AVATARS.each do |preset| %>
              <label class="cursor-pointer group flex flex-col items-center">
                <input type="radio" name="user[avatar_url]" value="<%= preset[:url] %>" class="peer sr-only"
                       onchange="selectPresetAvatar('<%= preset[:url] %>')">
                <div class="w-12 h-12 rounded-xl p-1 bg-slate-800 group-hover:bg-slate-700 border-2 border-transparent peer-checked:border-purple-500 peer-checked:bg-purple-950/60 transition-all flex items-center justify-center">
                  <img src="<%= preset[:url] %>" alt="<%= preset[:name] %>" class="w-full h-full object-contain rounded-lg">
                </div>
                <span class="text-[9px] text-slate-400 group-hover:text-slate-200 mt-1 truncate max-w-full text-center">
                  <%= preset[:name] %>
                </span>
              </label>
            <% end %>
          </div>
        </div>

        <!-- Custom Upload or URL -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-3 border-t border-slate-700/60 text-xs">
          <div>
            <label class="block font-medium text-slate-300 mb-1.5 flex items-center gap-1.5">
              <i class="fa-solid fa-upload text-indigo-400"></i> Загрузить файл с устройства
            </label>
            <%= f.file_field :avatar, accept: "image/*", onchange: "previewUploadedFile(this)",
                class: "block w-full text-xs text-slate-400 file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-purple-600 file:text-white hover:file:bg-purple-500 cursor-pointer" %>
          </div>

          <div>
            <label class="block font-medium text-slate-300 mb-1.5 flex items-center gap-1.5">
              <i class="fa-solid fa-link text-indigo-400"></i> Или прямая ссылка на изображение
            </label>
            <%= f.text_field :avatar_url, id: "avatar_url_input", placeholder: "https://example.com/avatar.jpg", oninput: "previewUrl(this.value)",
                class: "w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:border-purple-500" %>
          </div>
        </div>

      </div>

      <!-- Basic Profile Fields -->
      <div>
        <label class="block text-xs font-medium text-slate-300 mb-1">Имя</label>
        <%= f.text_field :name, placeholder: "Ваше имя",
            class: "w-full bg-slate-800 border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500" %>
      </div>

      <div>
        <label class="block text-xs font-medium text-slate-300 mb-1">О себе</label>
        <%= f.text_area :bio, rows: 3, placeholder: "Расскажите о ваших любимых игровых жанрах...",
            class: "w-full bg-slate-800 border border-slate-700 rounded-xl px-3.5 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500" %>
      </div>

      <div class="pt-4 flex items-center justify-between gap-3 border-t border-slate-800">
        <a href="/profile" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-300 transition-colors">
          Отмена
        </a>
        <%= f.submit "Сохранить изменения", class: "px-6 py-2.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold text-xs shadow-lg shadow-purple-600/30 cursor-pointer transition-all" %>
      </div>
    <% end %>
  </div>
</div>

<script>
  function selectPresetAvatar(url) {
    document.getElementById('avatar_url_input').value = url;
    previewUrl(url);
  }

  function previewUrl(url) {
    const preview = document.getElementById('avatar_preview');
    const placeholder = document.getElementById('avatar_preview_placeholder');
    if (url && url.trim().length > 0) {
      preview.src = url;
      preview.classList.remove('hidden');
      if (placeholder) placeholder.classList.add('hidden');
    }
  }

  function previewUploadedFile(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        previewUrl(e.target.result);
      };
      reader.readAsDataURL(input.files[0]);
    }
  }
</script>
