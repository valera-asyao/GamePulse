<div class="auth-wrap" style="width:min(720px,100%)">
  <section class="auth-panel">
    <div class="auth-head"><p class="eyebrow">Настройки</p><h1>Ваш профиль</h1><p>Имя, аватар и пара слов об игровых вкусах</p></div>
    <%= form_with model: @user, url: profile_path, method: :patch, multipart: true, class: "form-stack" do |f| %>
      <div class="field">
        <label>Аватар</label>
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:20px">
          <% if @user.avatar_image_url.present? %>
            <img id="avatar_preview" src="<%= @user.avatar_image_url %>" alt="<%= @user.display_name %>" class="avatar avatar-large">
          <% else %>
            <div id="avatar_preview_placeholder" class="avatar avatar-large avatar-fallback"><%= @user.display_name.first.upcase rescue "U" %></div>
            <img id="avatar_preview" src="" alt="Предпросмотр" class="avatar avatar-large hidden">
          <% end %>
          <span class="profile-meta">Выберите персонажа или загрузите своё изображение</span>
        </div>
        <div class="avatar-picker">
          <% User::PRESET_AVATARS.each do |preset| %>
            <label class="avatar-option" style="cursor:pointer">
              <input type="radio" name="user[avatar_url]" value="<%= preset[:url] %>" class="sr-only" onchange="selectPresetAvatar('<%= preset[:url] %>')">
              <span class="avatar-choice" style="display:block"><img src="<%= preset[:url] %>" alt="<%= preset[:name] %>" title="<%= preset[:name] %>"></span>
            </label>
          <% end %>
        </div>
      </div>
      <div class="form-grid">
        <div class="field"><label>Загрузить изображение</label><%= f.file_field :avatar, accept: "image/*", onchange: "previewUploadedFile(this)", class: "input" %></div>
        <div class="field"><label>Ссылка на изображение</label><%= f.text_field :avatar_url, id: "avatar_url_input", placeholder: "https://example.com/avatar.jpg", oninput: "previewUrl(this.value)", class: "input" %></div>
      </div>
      <div class="field"><label>Имя</label><%= f.text_field :name, placeholder: "Ваше имя", class: "input" %></div>
      <div class="field"><label>О себе</label><%= f.text_area :bio, rows: 4, placeholder: "Какие жанры и игры вам нравятся", class: "input" %></div>
      <div class="actions" style="justify-content:flex-end"><a href="/profile" class="button button-secondary">Отмена</a><%= f.submit "Сохранить профиль", class: "button button-primary" %></div>
    <% end %>
  </section>
</div>
<script>
  function selectPresetAvatar(url) {
    document.getElementById('avatar_url_input').value = url;
    previewUrl(url);
  }
  function previewUrl(url) {
    const preview = document.getElementById('avatar_preview');
    const placeholder = document.getElementById('avatar_preview_placeholder');
    if (url && url.trim().length > 0) {
      preview.src = url;
      preview.classList.remove('hidden');
      if (placeholder) placeholder.classList.add('hidden');
    }
  }
  function previewUploadedFile(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) { previewUrl(e.target.result); };
      reader.readAsDataURL(input.files[0]);
    }
  }
</script>
