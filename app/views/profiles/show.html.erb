<div class="space-y-6 max-w-5xl mx-auto">

  <!-- Profile Card -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-sm">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
      
      <div class="flex items-center gap-4">
        <% if @user.avatar_image_url.present? %>
          <img src="<%= @user.avatar_image_url %>" alt="<%= @user.display_name %>" class="w-16 h-16 rounded-xl object-cover border border-slate-700 shrink-0">
        <% else %>
          <div class="w-16 h-16 rounded-xl bg-indigo-600 flex items-center justify-center font-bold text-xl text-white shrink-0">
            <%= @user.display_name.first.upcase rescue "U" %>
          </div>
        <% end %>
        <div>
          <h1 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
            <%= @user.display_name %>
          </h1>
          <div class="text-xs text-slate-400 mt-0.5 flex items-center gap-2">
            <span>@<%= @user.username %></span>
            <span>•</span>
            <span><%= @user.email_address %></span>
          </div>
          <% if @user.bio.present? %>
            <p class="text-xs text-slate-300 mt-1.5 max-w-lg leading-relaxed"><%= @user.bio %></p>
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <a href="/profile/edit" class="px-3.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-750 border border-slate-700 text-xs font-medium text-slate-200 transition-colors flex items-center gap-1.5">
          <i class="fa-solid fa-pen-to-square text-xs"></i> Редактировать профиль
        </a>
      </div>

    </div>

    <!-- Quick Stats -->
    <div class="mt-6 pt-5 border-t border-slate-800 grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
      <div class="p-3 rounded-xl bg-slate-850 border border-slate-800">
        <div class="text-slate-400 text-xs">Оценено игр</div>
        <div class="text-lg font-bold text-white mt-0.5"><%= @rated_games.count %></div>
      </div>
      <div class="p-3 rounded-xl bg-slate-850 border border-slate-800">
        <div class="text-slate-400 text-xs">В избранном</div>
        <div class="text-lg font-bold text-amber-400 mt-0.5"><%= @favorite_games.count %></div>
      </div>
      <div class="p-3 rounded-xl bg-slate-850 border border-slate-800">
        <div class="text-slate-400 text-xs">Пройдено игр</div>
        <div class="text-lg font-bold text-emerald-400 mt-0.5"><%= @interactions.where(status: 'completed').count %></div>
      </div>
      <div class="p-3 rounded-xl bg-slate-850 border border-slate-800">
        <div class="text-slate-400 text-xs">Всего часов</div>
        <div class="text-lg font-bold text-indigo-400 mt-0.5"><%= @interactions.sum(:hours_played) %> ч.</div>
      </div>
    </div>
  </div>

  <!-- User's Rated Games Collection -->
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold text-white flex items-center gap-2">
        <i class="fa-solid fa-star text-amber-400 text-sm"></i> Мои оценки и активность
      </h2>
      <span class="text-xs text-slate-400"><%= @interactions.count %> записей</span>
    </div>

    <% if @interactions.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3.5">
        <% @interactions.each do |interaction| %>
          <% game = interaction.game %>
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-3.5 flex gap-3 shadow-sm items-center">
            <a href="<%= game_path(game) %>" class="relative w-24 aspect-[460/215] rounded-lg overflow-hidden shrink-0 bg-slate-950 border border-slate-800 flex items-center justify-center">
              <img src="<%= game.image_url %>" class="absolute inset-0 w-full h-full object-cover blur-sm opacity-20 scale-110 pointer-events-none">
              <img src="<%= game.image_url %>" alt="<%= game.title %>" class="relative z-10 w-full h-full object-contain">
            </a>
            <div class="flex-1 flex flex-col justify-between min-w-0 text-xs">
              <div>
                <a href="<%= game_path(game) %>" class="font-semibold text-white hover:text-indigo-400 transition-colors truncate block">
                  <%= game.title %>
                </a>
                <div class="text-[11px] text-slate-400 mt-0.5">
                  <% if interaction.rating %>
                    <span class="text-amber-400 font-bold">★ <%= interaction.rating %>/10</span>
                  <% end %>
                  <% if interaction.status.present? && interaction.status != 'none' %>
                    <span class="ml-1 text-slate-400">• <%= interaction.status %></span>
                  <% end %>
                </div>
              </div>
              <div class="flex items-center gap-2 text-xs mt-1">
                <% if interaction.liked %>
                  <span class="text-rose-400"><i class="fa-solid fa-heart"></i></span>
                <% end %>
                <% if interaction.favorite %>
                  <span class="text-amber-400"><i class="fa-solid fa-star"></i></span>
                <% end %>
                <% if interaction.hours_played > 0 %>
                  <span class="text-[10px] text-slate-400"><%= interaction.hours_played %>ч</span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-8 text-center bg-slate-900 border border-slate-800 rounded-xl text-slate-400 text-xs">
        Вы ещё не оценили ни одной игры. <a href="/" class="text-indigo-400 hover:text-indigo-300 ml-1">Перейти в каталог</a>
      </div>
    <% end %>
  </div>

</div>
