<div class="page-stack">
  <section class="profile-panel">
    <div class="profile-head">
      <div class="profile-identity">
        <% if @user.avatar_image_url.present? %>
          <img src="<%= @user.avatar_image_url %>" alt="<%= @user.display_name %>" class="avatar avatar-large">
        <% else %>
          <span class="avatar avatar-large avatar-fallback"><%= @user.display_name.first.upcase rescue "U" %></span>
        <% end %>
        <div>
          <p class="eyebrow">Профиль игрока</p>
          <h1><%= @user.display_name %></h1>
          <div class="profile-meta">@<%= @user.username %> · <%= @user.email_address %></div>
          <% if @user.bio.present? %><p class="profile-bio"><%= @user.bio %></p><% end %>
        </div>
      </div>
      <a href="/profile/edit" class="button button-secondary"><i class="fa-solid fa-pen"></i> Настроить</a>
    </div>
    <div class="stats">
      <div class="stat"><div class="stat-label">Оценено</div><div class="stat-value"><%= @rated_games.count %></div></div>
      <div class="stat"><div class="stat-label">В избранном</div><div class="stat-value"><%= @favorite_games.count %></div></div>
      <div class="stat"><div class="stat-label">Пройдено</div><div class="stat-value"><%= @interactions.where(status: 'completed').count %></div></div>
      <div class="stat"><div class="stat-label">Часов в играх</div><div class="stat-value"><%= @interactions.sum(:hours_played) %></div></div>
    </div>
  </section>

  <section>
    <div class="section-heading"><div><h2>Игровая история</h2><p><%= @interactions.count %> записей</p></div></div>
    <% if @interactions.any? %>
      <div class="activity-list">
        <% @interactions.each do |interaction| %>
          <% game = interaction.game %>
          <article class="activity-row">
            <a href="<%= game_path(game) %>"><img src="<%= game.image_url %>" alt="" class="activity-cover" loading="lazy"></a>
            <div>
              <a href="<%= game_path(game) %>" class="activity-title"><%= game.title %></a>
              <div class="activity-meta">
                <% labels = { 'want_to_play' => 'Хочу сыграть', 'playing' => 'Сейчас играю', 'completed' => 'Пройдено', 'dropped' => 'Заброшено' } %>
                <%= labels[interaction.status] || 'Без статуса' %>
                <% if interaction.hours_played > 0 %> · <%= interaction.hours_played %> ч<% end %>
                <% if interaction.favorite %> · В избранном<% end %>
              </div>
            </div>
            <% if interaction.rating %><span class="activity-rating"><%= interaction.rating %> / 10</span><% end %>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state"><p>Здесь появятся ваши оценки и игровой статус</p><a href="/" class="button button-primary">Перейти в каталог</a></div>
    <% end %>
  </section>
</div>
