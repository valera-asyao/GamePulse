<div class="space-y-12">

  <!-- Header -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-slate-800 text-emerald-400 text-xs font-medium mb-2">
          <i class="fa-solid fa-palette text-xs"></i> Лабораторный этап 4: UI Kit проекта
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
          UI Kit и дизайн-система GamePulse
        </h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1 max-w-2xl leading-relaxed">
          Единая библиотека стилей, компонентов и элементов управления, относящихся к кор-функционалу сервиса (каталог, формы оценки, рекомендации, фильтрация).
        </p>
      </div>
      <a href="/" class="shrink-0 px-3.5 py-2 rounded-lg bg-slate-800 hover:bg-slate-750 text-slate-200 text-xs font-medium border border-slate-700 flex items-center gap-1.5 transition-colors self-start sm:self-auto">
        <i class="fa-solid fa-arrow-left text-xs"></i> Вернуться к сайту
      </a>
    </div>
  </div>

  <!-- 1. Typography & Hierarchy -->
  <section class="space-y-4">
    <div class="border-b border-slate-800 pb-2">
      <h2 class="text-lg font-bold text-white flex items-center gap-2">
        <span class="w-6 h-6 rounded-md bg-indigo-600/20 text-indigo-400 text-xs font-bold flex items-center justify-center">1</span>
        Типографика и шрифтовая иерархия
      </h2>
      <p class="text-xs text-slate-400 mt-0.5">Основной шрифт: System Sans-Serif (Inter / Segoe UI / SF Pro)</p>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-4 items-baseline gap-2 pb-3 border-b border-slate-800/80">
        <span class="text-xs text-slate-500 font-mono">H1 / 32-36px Bold</span>
        <div class="md:col-span-3 text-2xl sm:text-3xl font-bold text-white">Персональные рекомендации видеоигр</div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 items-baseline gap-2 pb-3 border-b border-slate-800/80">
        <span class="text-xs text-slate-500 font-mono">H2 / 20-24px Bold</span>
        <div class="md:col-span-3 text-xl font-bold text-white">Каталог популярных видеоигр</div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 items-baseline gap-2 pb-3 border-b border-slate-800/80">
        <span class="text-xs text-slate-500 font-mono">H3 / 16-18px Semi</span>
        <div class="md:col-span-3 text-base font-semibold text-white">The Witcher 3: Wild Hunt</div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 items-baseline gap-2 pb-3 border-b border-slate-800/80">
        <span class="text-xs text-slate-500 font-mono">Body / 14px Regular</span>
        <div class="md:col-span-3 text-sm text-slate-300 leading-relaxed">
          Гибридный алгоритм анализирует вектор ваших оценок, сравнивает их с профилями других игроков и находит скрытые совпадения вкусов.
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 items-baseline gap-2">
        <span class="text-xs text-slate-500 font-mono">Caption / 11-12px Muted</span>
        <div class="md:col-span-3 text-xs text-slate-400">1420 отзывов • 2023 год • Релиз в Steam</div>
      </div>
    </div>
  </section>

  <!-- 2. Color Palette -->
  <section class="space-y-4">
    <div class="border-b border-slate-800 pb-2">
      <h2 class="text-lg font-bold text-white flex items-center gap-2">
        <span class="w-6 h-6 rounded-md bg-indigo-600/20 text-indigo-400 text-xs font-bold flex items-center justify-center">2</span>
        Цветовая палитра системы
      </h2>
      <p class="text-xs text-slate-400 mt-0.5">Минималистичная темная тема с акцентным индиго и функциональными цветами</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 text-center">
        <div class="h-12 rounded-lg bg-slate-950 border border-slate-800 mb-2"></div>
        <div class="text-xs font-semibold text-white">Background</div>
        <div class="text-[10px] text-slate-500 font-mono">#020617 (Slate 950)</div>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 text-center">
        <div class="h-12 rounded-lg bg-slate-900 border border-slate-750 mb-2"></div>
        <div class="text-xs font-semibold text-white">Surface / Card</div>
        <div class="text-[10px] text-slate-500 font-mono">#0f172a (Slate 900)</div>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 text-center">
        <div class="h-12 rounded-lg bg-indigo-600 mb-2"></div>
        <div class="text-xs font-semibold text-white">Primary Brand</div>
        <div class="text-[10px] text-slate-500 font-mono">#4f46e5 (Indigo 600)</div>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 text-center">
        <div class="h-12 rounded-lg bg-amber-400 mb-2"></div>
        <div class="text-xs font-semibold text-white">Rating / Star</div>
        <div class="text-[10px] text-slate-500 font-mono">#fbbf24 (Amber 400)</div>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 text-center">
        <div class="h-12 rounded-lg bg-emerald-500 mb-2"></div>
        <div class="text-xs font-semibold text-white">Success / Active</div>
        <div class="text-[10px] text-slate-500 font-mono">#10b981 (Emerald 500)</div>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 text-center">
        <div class="h-12 rounded-lg bg-rose-500 mb-2"></div>
        <div class="text-xs font-semibold text-white">Like / Error</div>
        <div class="text-[10px] text-slate-500 font-mono">#f43f5e (Rose 500)</div>
      </div>
    </div>
  </section>

  <!-- 3. Buttons & Interactive States -->
  <section class="space-y-4">
    <div class="border-b border-slate-800 pb-2">
      <h2 class="text-lg font-bold text-white flex items-center gap-2">
        <span class="w-6 h-6 rounded-md bg-indigo-600/20 text-indigo-400 text-xs font-bold flex items-center justify-center">3</span>
        Кнопки и варианты состояний
      </h2>
      <p class="text-xs text-slate-400 mt-0.5">Типы кнопок, размеры и поведение при наведении</p>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
      <div class="flex flex-wrap items-center gap-3">
        <button type="button" class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-xs transition-colors shadow-sm cursor-pointer">
          Primary Button
        </button>

        <button type="button" class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-750 text-slate-200 border border-slate-700 font-medium text-xs transition-colors cursor-pointer">
          Secondary Button
        </button>

        <button type="button" class="px-4 py-2 rounded-lg bg-slate-850 hover:bg-slate-800 text-slate-400 hover:text-slate-200 font-medium text-xs transition-colors cursor-pointer">
          Ghost Button
        </button>

        <button type="button" class="px-4 py-2 rounded-lg bg-rose-600 hover:bg-rose-500 text-white font-medium text-xs transition-colors shadow-sm cursor-pointer">
          Danger Action
        </button>

        <button type="button" disabled class="px-4 py-2 rounded-lg bg-slate-800/50 text-slate-500 border border-slate-800 text-xs font-medium cursor-not-allowed">
          Disabled State
        </button>

        <button type="button" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-slate-750 text-slate-300 border border-slate-700 flex items-center justify-center text-xs transition-colors cursor-pointer" title="Иконка">
          <i class="fa-solid fa-heart text-rose-500"></i>
        </button>

        <button type="button" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-slate-750 text-slate-300 border border-slate-700 flex items-center justify-center text-xs transition-colors cursor-pointer" title="Звезда">
          <i class="fa-solid fa-star text-amber-400"></i>
        </button>
      </div>
    </div>
  </section>

  <!-- 4. Form Controls (Core Functionality) -->
  <section class="space-y-4">
    <div class="border-b border-slate-800 pb-2">
      <h2 class="text-lg font-bold text-white flex items-center gap-2">
        <span class="w-6 h-6 rounded-md bg-indigo-600/20 text-indigo-400 text-xs font-bold flex items-center justify-center">4</span>
        Формы и элементы ввода данных
      </h2>
      <p class="text-xs text-slate-400 mt-0.5">Формы поиска, текстовые поля, выбор статуса, шкала оценки 1-10</p>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <!-- Text Input -->
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Текстовое поле (Email)</label>
          <input type="text" placeholder="user@example.com" value="gamer@example.com"
                 class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500">
        </div>

        <!-- Search Input -->
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Поиск игры с иконкой</label>
          <div class="relative">
            <input type="text" placeholder="Поиск по названию..." value="Witcher"
                   class="w-full bg-slate-800 border border-slate-700 rounded-lg pl-8 pr-3 py-1.5 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500">
            <i class="fa-solid fa-magnifying-glass absolute left-2.5 top-2 text-slate-400 text-xs"></i>
          </div>
        </div>

        <!-- Select Dropdown -->
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Выпадающий список (Статус)</label>
          <select class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-indigo-500">
            <option>Пройдено (Completed)</option>
            <option>Сейчас играю (Playing)</option>
            <option>Хочу сыграть (Wishlist)</option>
            <option>Заброшено (Dropped)</option>
          </select>
        </div>
      </div>

      <!-- Rating Scale 1-10 (Core rating widget) -->
      <div>
        <label class="block text-xs font-medium text-slate-300 mb-2">
          Шкала выставления оценки игре (1–10 баллов):
          <span class="text-indigo-400 font-bold ml-1">9 / 10</span>
        </label>
        <div class="grid grid-cols-10 gap-1 sm:gap-1.5 max-w-lg">
          <% (1..10).each do |num| %>
            <div class="h-8 rounded-md flex items-center justify-center text-xs font-semibold transition-colors cursor-pointer <%= num == 9 ? 'bg-indigo-600 text-white shadow-sm' : 'bg-slate-800 hover:bg-slate-750 text-slate-300' %>">
              <%= num %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Toggles & Checkboxes -->
      <div class="flex flex-wrap items-center gap-4 pt-1">
        <label class="flex items-center gap-2 p-2 rounded-lg bg-slate-800 border border-slate-750 cursor-pointer">
          <input type="checkbox" checked class="rounded border-slate-600 text-indigo-600 bg-slate-900">
          <span class="text-xs font-medium text-slate-200 flex items-center gap-1.5">
            <i class="fa-solid fa-heart text-rose-500 text-xs"></i> Отмечено как «Нравится»
          </span>
        </label>

        <label class="flex items-center gap-2 p-2 rounded-lg bg-slate-800 border border-slate-750 cursor-pointer">
          <input type="checkbox" checked class="rounded border-slate-600 text-amber-500 bg-slate-900">
          <span class="text-xs font-medium text-slate-200 flex items-center gap-1.5">
            <i class="fa-solid fa-star text-amber-400 text-xs"></i> Добавлено в «Избранное»
          </span>
        </label>
      </div>
    </div>
  </section>

  <!-- 5. Badges, Indicators & Alerts -->
  <section class="space-y-4">
    <div class="border-b border-slate-800 pb-2">
      <h2 class="text-lg font-bold text-white flex items-center gap-2">
        <span class="w-6 h-6 rounded-md bg-indigo-600/20 text-indigo-400 text-xs font-bold flex items-center justify-center">5</span>
        Бейджи, теги и сигналы
      </h2>
      <p class="text-xs text-slate-400 mt-0.5">Визуальные маркеры рейтингов, совпадения и уведомлений</p>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="bg-black/80 px-2 py-0.5 rounded text-xs font-semibold text-amber-300 border border-slate-750 flex items-center gap-1">
          <i class="fa-solid fa-star text-[10px]"></i> 9.3
        </span>

        <span class="bg-indigo-600/20 border border-indigo-500/30 px-2.5 py-0.5 rounded text-xs font-bold text-indigo-300">
          94% Match
        </span>

        <span class="px-2 py-0.5 rounded bg-slate-800 border border-slate-750 text-xs font-medium text-indigo-300">
          RPG
        </span>

        <span class="px-2 py-0.5 rounded bg-slate-800 border border-slate-750 text-xs font-medium text-indigo-300">
          Открытый мир
        </span>

        <span class="px-2 py-0.5 rounded bg-slate-800 text-xs text-slate-400">
          #singleplayer
        </span>

        <span class="text-[10px] text-emerald-400 font-medium px-2 py-0.5 rounded-md bg-emerald-950/60 border border-emerald-800/80">
          Сохранено
        </span>
      </div>

      <!-- Flash Notification Examples -->
      <div class="space-y-2 pt-2">
        <div class="bg-emerald-950/60 border border-emerald-700/50 text-emerald-200 px-3.5 py-2 rounded-lg flex items-center justify-between text-xs">
          <span class="flex items-center gap-2">
            <i class="fa-solid fa-circle-check text-emerald-400"></i> Рекомендации успешно пересчитаны!
          </span>
          <span class="text-emerald-400 text-xs">✕</span>
        </div>

        <div class="bg-rose-950/60 border border-rose-700/50 text-rose-200 px-3.5 py-2 rounded-lg flex items-center justify-between text-xs">
          <span class="flex items-center gap-2">
            <i class="fa-solid fa-triangle-exclamation text-rose-400"></i> Неверный логин или пароль.
          </span>
          <span class="text-rose-400 text-xs">✕</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Ready Functional Cards (Mockups with Dummy Data) -->
  <section class="space-y-4">
    <div class="border-b border-slate-800 pb-2">
      <h2 class="text-lg font-bold text-white flex items-center gap-2">
        <span class="w-6 h-6 rounded-md bg-indigo-600/20 text-indigo-400 text-xs font-bold flex items-center justify-center">6</span>
        Кор-карточки интерфейса с заглушками
      </h2>
      <p class="text-xs text-slate-400 mt-0.5">Образцы итоговых блоков каталога и персональных рекомендаций</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- Card Type A: Game Catalog Card -->
      <div class="space-y-2">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">А. Карточка игры в каталоге</div>
        <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-sm flex flex-col">
          <div class="relative aspect-[460/215] overflow-hidden bg-slate-950 block border-b border-slate-800">
            <img src="<%= @sample_game.image_url %>" class="absolute inset-0 w-full h-full object-cover blur-sm opacity-20 scale-110 pointer-events-none">
            <img src="<%= @sample_game.image_url %>" alt="<%= @sample_game.title %>" class="relative z-10 w-full h-full object-contain">
            
            <div class="absolute top-2 left-2 z-20 flex items-center gap-1.5">
              <span class="bg-black/80 backdrop-blur-sm px-2 py-0.5 rounded text-xs font-semibold text-amber-300 border border-slate-750 flex items-center gap-1">
                <i class="fa-solid fa-star text-[10px]"></i> <%= @sample_game.average_rating %>
              </span>
              <span class="bg-black/80 backdrop-blur-sm px-2 py-0.5 rounded text-[10px] text-slate-400 border border-slate-800">
                <%= @sample_game.ratings_count %>
              </span>
            </div>

            <div class="absolute top-2 right-2 z-20 bg-indigo-600 px-2 py-0.5 rounded text-xs font-bold text-white shadow-sm">
              96% Match
            </div>
          </div>

          <div class="p-3.5 flex flex-col justify-between flex-1">
            <div>
              <div class="font-semibold text-sm text-white">The Witcher 3: Wild Hunt</div>
              <p class="text-xs text-slate-400 mt-1 line-clamp-2">
                Сюжетная ролевая игра с открытым миром, созданная по мотивам романов Анджея Сапковского.
              </p>
              <div class="flex flex-wrap gap-1 mt-2.5">
                <span class="px-1.5 py-0.5 rounded bg-slate-800 text-[10px] font-medium text-slate-400">RPG</span>
                <span class="px-1.5 py-0.5 rounded bg-slate-800 text-[10px] font-medium text-slate-400">Открытый мир</span>
              </div>
            </div>

            <div class="mt-3 pt-2.5 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
              <span>2015 год</span>
              <span class="text-indigo-400 font-medium">Подробнее →</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Card Type B: Recommendation Card with Signal Breakdown -->
      <div class="space-y-2">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Б. Карточка персональной рекомендации</div>
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-start justify-between gap-3 mb-2.5">
              <div class="flex items-center gap-2">
                <span class="w-6 h-6 rounded-md bg-slate-800 text-indigo-400 font-bold text-xs flex items-center justify-center">
                  #1
                </span>
                <div>
                  <div class="font-semibold text-sm text-white">Cyberpunk 2077</div>
                  <div class="text-[10px] text-slate-400">2020 • RPG, Экшен, Киберпанк</div>
                </div>
              </div>

              <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-indigo-600/20 border border-indigo-500/30 text-indigo-300 font-semibold text-xs">
                92% Match
              </div>
            </div>

            <!-- Reason Box (XAI) -->
            <div class="p-2.5 rounded-lg bg-slate-850 border border-slate-800 text-slate-300 text-xs mb-3">
              <div class="text-[10px] font-semibold uppercase text-indigo-400 mb-0.5 flex items-center gap-1">
                <i class="fa-solid fa-brain"></i> Почему рекомендовано:
              </div>
              <p class="text-xs text-slate-300">Подходит под ваш интерес к жанрам RPG и открытому миру. Высоко оценено игроками со схожими оценками (~9.2/10).</p>
            </div>

            <!-- Signal Progress Bars -->
            <div class="space-y-1.5 text-[10px]">
              <div>
                <div class="flex justify-between text-slate-400 mb-0.5">
                  <span>Жанры & Теги (40%)</span>
                  <span class="text-slate-200 font-medium">95%</span>
                </div>
                <div class="w-full h-1 bg-slate-800 rounded-full overflow-hidden">
                  <div class="h-full bg-indigo-500 rounded-full" style="width: 95%"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-slate-400 mb-0.5">
                  <span>Похожие игроки (30%)</span>
                  <span class="text-slate-200 font-medium">88%</span>
                </div>
                <div class="w-full h-1 bg-slate-800 rounded-full overflow-hidden">
                  <div class="h-full bg-indigo-400 rounded-full" style="width: 88%"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-slate-400 mb-0.5">
                  <span>Популярность (20%)</span>
                  <span class="text-slate-200 font-medium">90%</span>
                </div>
                <div class="w-full h-1 bg-slate-800 rounded-full overflow-hidden">
                  <div class="h-full bg-amber-400 rounded-full" style="width: 90%"></div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-3 pt-2.5 border-t border-slate-800 flex items-center justify-between text-xs">
            <span class="text-[11px] text-slate-400">1820 оценок в базе</span>
            <span class="px-2.5 py-1 rounded-md bg-indigo-600 text-white font-medium text-xs">Перейти к игре →</span>
          </div>
        </div>
      </div>

    </div>
  </section>

</div>
