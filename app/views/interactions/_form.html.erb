<aside id="game_interaction_<%= game.id %>" class="interaction-panel">
  <% if authenticated? %>
    <% interaction ||= current_user.interactions.find_or_initialize_by(game: game) %>
    <h2>Ваш игровой опыт</h2>
    <%= form_with model: interaction, url: game_interaction_path(game), method: (interaction.persisted? ? :patch : :post), class: "form-stack" do |f| %>
      <div class="field">
        <label>Ваша оценка · <span id="rating_val_<%= game.id %>"><%= interaction.rating || "—" %></span>/10</label>
        <div class="rating-scale">
          <% (1..10).each do |num| %>
            <label>
              <%= f.radio_button :rating, num, class: "peer sr-only", onchange: "document.getElementById('rating_val_#{game.id}').innerText = '#{num}'" %>
              <span class="rating-option"><%= num %></span>
            </label>
          <% end %>
        </div>
      </div>
      <div class="toggle-grid">
        <label class="toggle"><%= f.check_box :liked %> Нравится</label>
        <label class="toggle"><%= f.check_box :favorite %> В избранное</label>
      </div>
      <div class="form-grid">
        <div class="field">
          <label>Статус</label>
          <%= f.select :status, [["Не указано", "none"],["Хочу сыграть", "want_to_play"],["Сейчас играю", "playing"],["Пройдено", "completed"],["Заброшено", "dropped"]], {}, class: "input" %>
        </div>
        <div class="field"><label>Часов сыграно</label><%= f.number_field :hours_played, min: 0, placeholder: "0", class: "input" %></div>
      </div>
      <%= f.submit interaction.persisted? ? "Сохранить изменения" : "Сохранить оценку", class: "button button-primary" %>
    <% end %>
  <% else %>
    <h2>Была ли игра вашей?</h2>
    <p class="lead">Войдите, чтобы оценить игру и улучшить свою подборку</p>
    <div class="actions"><a href="/session/new" class="button button-primary">Войти</a><a href="/registration/new" class="button button-secondary">Регистрация</a></div>
  <% end %>
</aside>
